# Gas Abstraction Debugger Configuration
# Copy this file to .env and fill in your API keys

# Provider API Keys (optional - will use public endpoints if not provided)
PIMLICO_API_KEY=your_pimlico_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
BICONOMY_API_KEY=your_biconomy_api_key_here
GELATO_API_KEY=your_gelato_api_key_here

# Logging Configuration
LOG_LEVEL=info

# Test Configuration
DEFAULT_ITERATIONS=1
DEFAULT_TIMEOUT=30000