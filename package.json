{
  "name": "gas-abstraction-debugger",
  "version": "0.1.0",
  "description": "CLI tool for testing and debugging gas abstraction providers across chains",
  "main": "dist/index.js",
  "bin": {
    "gas-debug": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "gas-abstraction",
    "account-abstraction",
    "eip-4337",
    "web3",
    "ethereum",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ethers": "^6.8.0",
    "ora": "^7.0.1",
    "table": "^6.8.1"
  }
}
